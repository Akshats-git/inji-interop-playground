# Copied to .env by ./playground.sh, which fills in the secrets and the mode settings.
# Never commit .env: it holds the key that decrypts recorded protocol messages.

# Host port for the playground (UI, API and the gateway wallets talk to).
PLAYGROUND_PORT=8080

# Days before runs and recorded messages are purged.
RETENTION_DAYS=7

# Generated on first start: base64 of 32 random bytes (AES-256-GCM key for stored payloads).
EVENT_ENCRYPTION_KEY=

# In tunnel mode only the wallet-facing gateway (/pub/*) is public. "true" also exposes the UI and the API,
# including recorded tokens, to anyone who has the URL. Leave it off unless you need the UI on a phone.
PUBLIC_UI=false

# Generated on first start for a new database.
POSTGRES_PASSWORD=

# Written by ./playground.sh up (local) or ./playground.sh tunnel (public HTTPS, did:web identities):
# PLAYGROUND_MODE, PUBLIC_BASE_URL, CERTIFY_DEFAULT_DID, VERIFY_DID, VERIFY_COOKIE_SECURE
