# Copy to .env (./playground.sh up does this for you and fills in the secrets).
# Origin wallets use to reach the playground. Keep the default for laptop-only use; set it to your
# tunnel's https URL (./playground.sh tunnel) when a phone wallet must connect.
PUBLIC_BASE_URL=http://playground.localhost:8080
PLAYGROUND_PORT=8080
# AES-256-GCM key (base64, 32 bytes) for protocol events at rest. Generated by ./playground.sh.
EVENT_ENCRYPTION_KEY=
POSTGRES_PASSWORD=postgres
# Recorded protocol events older than this are purged.
RETENTION_DAYS=7
